# Used by docker compose (copy to .env to override the defaults)
PORT=3000
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare
POSTGRES_DB=healthcare
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Only needed when running the API outside Docker (npm run dev)
DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare
