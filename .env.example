# Copy to .env — docker compose reads it automatically.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare
POSTGRES_DB=healthcare
# Only used when running the API outside Docker (npm run dev)
DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
# Comma-separated list of allowed origins, or *
CORS_ORIGIN=*
# Requests per 15 minutes per IP on /api/auth/*
AUTH_RATE_LIMIT_MAX=20
